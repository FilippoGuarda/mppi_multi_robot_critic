<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mppi_multi_robot_critic</name>
  <version>0.1.0</version>
  <description>Interaction-aware MPPI critic for multi-agent navigation based on the Trevisan et al. paper</description>
  
  <maintainer email="filippo.guarda96@gmail.com">Filippo Guarda</maintainer>
  <license>Apache-2.0</license>
  
  <author>Your Name</author>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2</depend>
  <depend>Eigen3</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/critic_plugins.xml"/>
  </export>
</package>
